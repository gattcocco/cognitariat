# Variabili SOLO server, lette a runtime dalle Cloudflare Pages Functions in /functions
# (context.env). Copia in .dev.vars per `wrangler pages dev` in locale.
# In produzione vanno impostate nelle Environment Variables del progetto Cloudflare Pages,
# MAI committate qui.
#
# La secret key di Turnstile NON è tra queste: si configura in Supabase Auth (dashboard),
# non nel nostro runtime — vedi piano §2.

PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID delle 3 fasce (creati su Stripe Dashboard, non gli importi in chiaro)
STRIPE_PRICE_SOLIDARIETA=price_...
STRIPE_PRICE_PRECARIA=price_...
STRIPE_PRICE_STABILE=price_...

# Price ID merch (fase 2)
STRIPE_PRICE_MERCH_TSHIRT=price_...
STRIPE_PRICE_MERCH_PIN=price_...
STRIPE_PRICE_MERCH_POSTER=price_...

# Origine pubblica del sito, usata per costruire i redirect di Stripe Checkout/Portal
SITE_URL=http://localhost:4321
