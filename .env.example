# Variabili "PUBLIC_*": finiscono nel bundle JS lato browser (Astro/Vite le inlina al build).
# Copia questo file in .env e compila con i valori del progetto Supabase (mai chiavi segrete qui).

PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Site key del widget Turnstile (pubblica). La secret key NON va qui: si configura
# direttamente in Supabase Auth → Authentication → Bot and Abuse Protection.
PUBLIC_TURNSTILE_SITE_KEY=0x...

# Gemella lato browser di PAGAMENTI_ATTIVI. Serve solo a decidere se il ritorno
# dal magic link puo' proseguire verso il pagamento: e' un dettaglio di comodita',
# non un confine di sicurezza — quello sta nelle Functions (src/lib/pagamenti.ts),
# che rifiutano comunque la richiesta se la bandiera server non e' "true".
PUBLIC_PAGAMENTI_ATTIVI=false
