---
---
<div id="membership-signup" class="member-form">
  <h3 style="margin-bottom: 6px;">Iscriviti a COG U</h3>
  <p class="form-note" id="signup-selected-tier">Scegli prima una fascia qui sopra, oppure iscriviti e sceglierai dopo.</p>

  <form id="signup-form">
    <input type="hidden" id="signup-tier" value="" />

    <label for="signup-name">Nome e cognome</label>
    <input type="text" id="signup-name" name="fullName" autocomplete="name" required />

    <label for="signup-email">Email</label>
    <input type="email" id="signup-email" name="email" autocomplete="email" required />

    <div class="consent-row">
      <input type="checkbox" id="consent-privacy" required />
      <label for="consent-privacy" style="margin:0; font-weight:400;">
        Ho letto e accetto l'<a href="/privacy">informativa privacy</a>.
      </label>
    </div>
    <!--
      PROVVISORIO: formulazione/necessità di questo secondo checkbox da confermare solo
      dopo aver verificato con la compliance/legale del cliente che la base giuridica
      art. 9(2)(d) GDPR si applichi davvero alla forma giuridica e alle attività reali di
      COG U (vedi piano §4). Non trattare questo testo come definitivo.
    -->
    <div class="consent-row">
      <input type="checkbox" id="consent-art9" required />
      <label for="consent-art9" style="margin:0; font-weight:400;">
        Acconsento al trattamento del mio dato di iscrizione sindacale (fascia di
        tesseramento) ai sensi dell'art. 9 GDPR.
      </label>
    </div>

    <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} style="margin: 16px 0;"></div>

    <button class="btn-primary" type="submit">
      <i class="fas fa-envelope" aria-hidden="true"></i> Inviami il link di accesso
    </button>

    <p class="form-note">Niente password: ti mandiamo un link via email, valido per un unico accesso.</p>
    <div id="signup-message" role="status"></div>
  </form>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { supabase } from '../lib/supabase-browser';
  import { PRIVACY_POLICY_VERSION } from '../lib/consent';

  const form = document.getElementById('signup-form') as HTMLFormElement;
  const tierInput = document.getElementById('signup-tier') as HTMLInputElement;
  const tierNote = document.getElementById('signup-selected-tier') as HTMLElement;
  const messageEl = document.getElementById('signup-message') as HTMLElement;

  const TIER_LABELS: Record<string, string> = {
    solidarieta: 'Solidarietà — €10/anno',
    precaria: 'Precariə — €20/anno',
    stabile: 'Stabile — €30/anno',
  };

  function setTier(tier: string) {
    tierInput.value = tier;
    tierNote.textContent = TIER_LABELS[tier]
      ? `Fascia scelta: ${TIER_LABELS[tier]}`
      : 'Scegli prima una fascia qui sopra, oppure iscriviti e sceglierai dopo.';
  }

  document.addEventListener('cogu:select-tier', (e: Event) => {
    const tier = (e as CustomEvent<string>).detail;
    setTier(tier);
    document.getElementById('membership-signup')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    document.getElementById('signup-email')?.focus();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    messageEl.textContent = '';
    messageEl.className = '';

    const email = (document.getElementById('signup-email') as HTMLInputElement).value;
    const fullName = (document.getElementById('signup-name') as HTMLInputElement).value;
    const tier = tierInput.value;

    // Token del widget Turnstile: Supabase Auth (configurato con Bot and Abuse Protection)
    // lo verifica lato server. È QUESTO il confine anti-abuso reale, non una nostra
    // Function intermedia — anon key e URL Supabase sono comunque pubblici, quindi
    // signInWithOtp() senza captchaToken valido deve essere rifiutata da Supabase stesso.
    const captchaToken = (document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement)?.value;

    if (!captchaToken) {
      messageEl.textContent = 'Completa la verifica anti-spam prima di continuare.';
      messageEl.className = 'form-error';
      return;
    }

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;

    const redirectTo = new URL('/auth/callback', location.origin);
    if (tier) redirectTo.searchParams.set('tier', tier);

    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        captchaToken,
        emailRedirectTo: redirectTo.toString(),
        data: {
          full_name: fullName,
          privacy_version: PRIVACY_POLICY_VERSION,
          privacy_seen_at: new Date().toISOString(),
        },
      },
    });

    submitBtn.disabled = false;
    (window as any).turnstile?.reset();

    if (error) {
      messageEl.textContent = `Non siamo riusciti a inviare il link: ${error.message}`;
      messageEl.className = 'form-error';
      return;
    }

    form.reset();
    setTier('');
    messageEl.textContent = 'Controlla la tua email: ti abbiamo mandato un link di accesso.';
    messageEl.className = 'form-note';
  });
</script>
