---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Area membro — COG U">
  <Header />
  <main class="container" style="padding: 60px 0;">
    <div id="account-loading" style="text-align:center;">Carico la tua tessera…</div>

    <div id="account-signed-out" style="display:none; text-align:center;">
      <p>Devi accedere per vedere la tua tessera.</p>
      <a class="btn-primary" href="/#membership" style="margin-top: 16px;">Vai all'iscrizione</a>
    </div>

    <div id="account-content" style="display:none;">
      <div class="member-card">
        <div class="member-card-tier" id="mc-tier">—</div>
        <span class="member-card-status" id="mc-status">—</span>
        <dl>
          <dt>Iscritto/a come</dt><dd id="mc-name">—</dd>
          <dt>Email</dt><dd id="mc-email">—</dd>
          <dt>Quota versata</dt><dd id="mc-amount">—</dd>
          <dt>Valida fino al</dt><dd id="mc-valid-until">—</dd>
          <dt>Informativa privacy</dt><dd id="mc-privacy">—</dd>
        </dl>
      </div>

      <div class="account-actions">
        <!--
          Niente Customer Portal Stripe: la quota 2026 è un pagamento one-off, senza
          rinnovo automatico — non c'è un abbonamento da gestire (piano v3). La ricevuta
          arriva via email da Stripe automaticamente.
        -->
        <button class="btn-outline" type="button" id="btn-logout">
          <i class="fas fa-right-from-bracket" aria-hidden="true"></i> Esci
        </button>
        <!--
          La cancellazione automatica è disabilitata di proposito finché la retention
          matrix non è definita (piano §6) — vedi functions/api/account-delete.ts.
          Nel frattempo si passa da una richiesta via email, non da self-service.
        -->
        <a href="mailto:cognitariatz@proton.me?subject=Richiesta%20cancellazione%20account" style="font-size:0.85rem; margin-top: 8px; color: var(--verde); text-decoration: underline;">
          Richiedi la cancellazione del tuo account
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase-browser';
  import { TIER_LABELS } from '../lib/tiers';

  const STATUS_LABELS: Record<string, string> = {
    pending: 'Iscrizione avviata, in attesa di pagamento',
    payment_pending: 'Pagamento in corso di conferma',
    active: 'Attiva',
    payment_failed: 'Pagamento non riuscito — riprova dall\'iscrizione',
    rejected: 'Iscrizione non accettata — quota rimborsata, scrivici per informazioni',
  };

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    const loading = document.getElementById('account-loading')!;

    if (!session) {
      loading.style.display = 'none';
      document.getElementById('account-signed-out')!.style.display = 'block';
      return;
    }

    const [{ data: profile }, { data: membership }, { data: acceptance }] = await Promise.all([
      supabase.from('member_profiles').select('first_name, last_name').eq('id', session.user.id).single(),
      supabase.from('memberships').select('tier, status, amount_paid_cents, valid_until').eq('user_id', session.user.id).single(),
      supabase
        .from('privacy_acceptances')
        .select('version, accepted_at')
        .eq('user_id', session.user.id)
        .order('accepted_at', { ascending: false })
        .limit(1)
        .maybeSingle(),
    ]);

    loading.style.display = 'none';
    document.getElementById('account-content')!.style.display = 'block';

    const tierValue = membership?.tier as string | null | undefined;
    const displayName = [profile?.first_name, profile?.last_name].filter(Boolean).join(' ');

    document.getElementById('mc-tier')!.textContent = tierValue ? (TIER_LABELS[tierValue as keyof typeof TIER_LABELS] ?? tierValue) : 'Nessuna fascia attiva';
    document.getElementById('mc-status')!.textContent = STATUS_LABELS[membership?.status ?? 'pending'];
    document.getElementById('mc-name')!.textContent = displayName || session.user.email || '—';
    document.getElementById('mc-email')!.textContent = session.user.email ?? '—';
    document.getElementById('mc-amount')!.textContent =
      typeof membership?.amount_paid_cents === 'number' ? `€${(membership.amount_paid_cents / 100).toFixed(2)}` : '—';
    document.getElementById('mc-valid-until')!.textContent = membership?.valid_until ?? '—';
    document.getElementById('mc-privacy')!.textContent = acceptance
      ? `accettata il ${new Date(acceptance.accepted_at).toLocaleDateString('it-IT')} (versione ${acceptance.version})`
      : '—';

    document.getElementById('btn-logout')!.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    });
  }

  init();
</script>
