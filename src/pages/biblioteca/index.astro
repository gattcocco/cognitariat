---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { vociDaCostruire, urlLicenza, sitoDi, perTipo, etichettaAzione } from '../../lib/biblioteca';
import { bozzeVisibili } from '../../lib/articoli';

/**
 * Biblioteca: i testi fondamentali a licenza libera.
 *
 * Una sola pagina, nessuna pagina per voce: ogni scheda rimanda al PDF sul sito
 * di chi lo pubblica. Non ospitiamo file — vedi la nota in src/content.config.ts.
 *
 * `vociDaCostruire` e non `getCollection` diretto: e' il punto in cui una bozza
 * smette di esistere in una build pubblica.
 */
const voci = await vociDaCostruire();
const bozze = voci.filter((v) => v.data.bozza).length;
const gruppi = perTipo(voci);

/** Il titolo di ogni gruppo, al plurale, e una riga che dice cosa ci si trova. */
const SEZIONI: Record<string, { titolo: string; nota: string }> = {
  Paper: { titolo: 'Paper', nota: 'Articoli di ricerca, quasi tutti scaricabili gratis.' },
  Rapporto: { titolo: 'Rapporti e guide', nota: 'Documenti di sindacati e organizzazioni, pensati per chi negozia e organizza.' },
  Libro: { titolo: 'Libri', nota: 'Alcuni si leggono gratis online, altri sono a pagamento: la scheda lo dice.' },
  Strumento: { titolo: 'Strumenti', nota: 'Programmi e standard per costruire e misurare, con la loro licenza.' },
};
---
<BaseLayout
  title="Biblioteca — COG U"
  description="I testi per capire l'AI e il lavoro e per costruirne una nostra: paper, rapporti, libri e strumenti, con la licenza di ciascuno."
>
  <Header />
  <main id="contenuto" tabindex="-1" class="container pagina-testo">
    <div class="prosa">
      <h1 class="section-title">Biblioteca</h1>
      <p>
        I testi che per noi contano: paper, rapporti, libri e strumenti per capire l'AI e il lavoro, e per
        costruirne una nostra. Non ne teniamo copie. Ogni scheda porta al sito di chi lo pubblica, e
        lì valgono le condizioni della licenza indicata: per i libri a pagamento lo diciamo apertamente.
      </p>
    </div>

    {bozzeVisibili && bozze > 0 && (
      <p class="nota-metodo" style="margin-top: 28px;">
        {bozze === 1
          ? "Questa è un'anteprima locale: una voce è ancora una bozza ed è visibile solo qui."
          : `Questa è un'anteprima locale: ${bozze} voci sono ancora bozze e sono visibili solo qui.`}
        {' '}Sul sito costruito le bozze non compaiono da nessuna parte.
      </p>
    )}

    {voci.length === 0 ? (
      <p class="prosa" style="margin-top: 40px;">La biblioteca è ancora vuota.</p>
    ) : (
      gruppi.map((g) => (
      <section aria-labelledby={`sezione-${g.tipo}`}>
      <h2 class="biblioteca-sezione" id={`sezione-${g.tipo}`}>{SEZIONI[g.tipo].titolo}</h2>
      <p class="biblioteca-sezione-nota">{SEZIONI[g.tipo].nota}</p>
      <ul class="biblioteca-elenco">
        {g.voci.map((voce) => {
          const d = voce.data;
          const licenzaUrl = urlLicenza(d.licenza);
          const destinazione = (d.urlPdf ?? d.urlScheda) as string;
          return (
            <li>
              <article class="voce-biblioteca" id={voce.id}>
                <p class="voce-tema">{d.tema}</p>
                <h3 class="voce-titolo">{d.title}</h3>
                <p class="voce-citazione">
                  {[d.autori, String(d.anno), d.pubblicatoIn].filter(Boolean).join(' · ')}
                </p>
                <p class="voce-sommario">{d.excerpt}</p>
                <p class="voce-azioni">
                  <a
                    class="voce-pdf"
                    href={destinazione}
                    rel="noopener noreferrer"
                    aria-label={`${etichettaAzione(d.tipo, !!d.urlPdf)}: ${d.title} (si apre su ${sitoDi(destinazione)})`}
                  >{etichettaAzione(d.tipo, !!d.urlPdf)}</a>
                  <span class="voce-licenza">
                    {licenzaUrl ? (
                      <a href={licenzaUrl} rel="noopener noreferrer">{d.licenza}</a>
                    ) : (
                      d.licenza
                    )}
                  </span>
                  <span class="voce-sito">su {sitoDi(destinazione)}</span>
                  {d.urlPdf && d.urlScheda && (
                    <a class="link" href={d.urlScheda} rel="noopener noreferrer">Pagina ufficiale</a>
                  )}
                </p>
                {d.bozza && <p class="occhiello occhiello--progetto">Bozza — non pubblicata</p>}
              </article>
            </li>
          );
        })}
      </ul>
      </section>
      ))
    )}
  </main>
  <Footer />
</BaseLayout>
