---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banners from '../components/Banners.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CosaSucceded from '../components/CosaSucceded.astro';
import PercheCiPreoccupa from '../components/PercheCiPreoccupa.astro';
import Lavoro from '../components/Lavoro.astro';
import Alternative from '../components/Alternative.astro';
import AssemblyBanner from '../components/AssemblyBanner.astro';
import CosaFacciamo from '../components/CosaFacciamo.astro';
import Agenda from '../components/Agenda.astro';
import Manifesto from '../components/Manifesto.astro';
import Articoli from '../components/Articoli.astro';
import VideoInterviews from '../components/VideoInterviews.astro';
import CosaCostruiamo from '../components/CosaCostruiamo.astro';
import Avvicinarsi from '../components/Avvicinarsi.astro';
import Imaginarium from '../components/Imaginarium.astro';
import Membership from '../components/Membership.astro';
import Merch from '../components/Merch.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <Banners />
  <Header />
  <main id="contenuto" tabindex="-1">
    <!--
      Ordine editoriale di docs/copy-home-v2.md: prima cosa succede, poi perche'
      ci preoccupa, poi il lavoro, poi le alternative (che occupano almeno tanto
      spazio quanto le preoccupazioni), poi cosa facciamo davvero, poi cosa e'
      solo un progetto, infine come avvicinarsi.
      "Perche' ci preoccupa" e' tornata in Fase 5 riscritta da zero: la versione
      precedente reggeva sull'acronimo MANGOS, questa su due decisioni gia' prese
      e un dato gia' misurato. Resta piu' corta delle alternative, di proposito.
    -->
    <!--
      L'AGENDA APRE LA PAGINA (richiesta del committente, 25/11/2026).
      La prima schermata non e' piu' un testo che spiega: sono le locandine dei
      prossimi appuntamenti. Un appuntamento ha una scadenza, e se di questa home
      si legge solo la prima schermata quello che deve restare e' dove ci si puo'
      incontrare.
      Tre conseguenze, tutte gia' gestite:
      - la sezione non esiste quando non c'e' niente in calendario (e il suo
        script la nasconde se gli ultimi appuntamenti scadono dopo la build):
        in quel caso la prima schermata torna a essere l'hero, qui sotto, senza
        lasciare un buco;
      - l'intro d'ingresso anima il blocco che si vede davvero. Lo script in
        fondo a questo file sceglie a tempo di esecuzione fra agenda e hero;
      - il titolo della pagina (h1) resta quello del manifesto, nell'hero: a
        cambiare e' la posizione in pagina, non la gerarchia dei contenuti.
    -->
    <Agenda />
    <!--
      L'hero scende sotto l'agenda: resta la presentazione del sindacato — chi
      siamo e perche' — ma non e' piu' la prima cosa che si vede.
    -->
    <Hero />
    <CosaSucceded />
    <PercheCiPreoccupa />
    <Lavoro />
    <Alternative />
    <AssemblyBanner />
    <CosaFacciamo />
    <!--
      La locandina sta a meta' strada: dopo le sezioni che spiegano, prima di
      quelle che invitano a leggere altro. E' una pausa, e il punto in cui la
      pagina smette per un attimo di argomentare.
    -->
    <Manifesto />
    <Articoli />
    <VideoInterviews />
    <CosaCostruiamo />
    <Avvicinarsi />
    <Imaginarium />
    <!--
      Tesseramento e merch restano nella pagina con le strutture intatte, ma con
      gli acquisti disabilitati: nessun pulsante deve far pensare che si possa
      gia' pagare. Vedi Fase 5 per il gating lato server.
    -->
    <Membership />
    <Merch />
    <Footer />
  </main>
</BaseLayout>

<script>
  /**
   * Intro d'ingresso. Sta in una funzione e non a livello di modulo perche' ha
   * piu' di un motivo per rinunciare a meta' strada, e "return" a livello di
   * modulo non e' consentito.
   */
  async function avviaIntro() {
    try {
      // anime.js arriva dal nostro bundle, non da jsdelivr. In Fase 4 la CDN non
      // rispondeva e l'intro restava a meta': con il pacchetto in locale quel modo
      // di rompersi sparisce, e resta un import dinamico, cosi' il codice
      // dell'animazione non pesa sul caricamento iniziale della pagina.
      const { createTimeline, stagger, utils } = await import('animejs');

      // Il modulo puo' arrivare dopo che il failsafe ha gia' scoperto la pagina:
      // con una rete lenta il testo diventa leggibile a 3 secondi e il chunk
      // atterra dopo. Ripartire da li' vorrebbe dire coprire di nero una pagina
      // che la persona sta gia' leggendo. Meglio niente intro.
      if (window.__coguRivelato) return;

      const overlay = document.createElement('div');
      overlay.className = 'cogu-intro-overlay';
      overlay.setAttribute('aria-hidden', 'true');
      overlay.innerHTML =
        '<div class="cogu-intro-mark">' +
        '<span class="cogu-intro-brand">COG U</span>' +
        '<span class="cogu-intro-tag">Sindacato del cognitariato</span>' +
        '<span class="cogu-intro-rule"></span>' +
        '</div>';
      document.body.appendChild(overlay);

      const elementi = (sel: string) =>
        Array.from(document.querySelectorAll<HTMLElement>(sel));

      /**
       * QUALE BLOCCO APRE LA PAGINA.
       *
       * Da quando l'agenda sta in cima, la cascata d'ingresso deve animare
       * l'agenda: animare l'hero vorrebbe dire far entrare in scena qualcosa
       * che in quel momento sta sotto la piega, e lasciare immobile la sola
       * cosa che si vede.
       *
       * L'agenda pero' puo' non esserci: la sezione non viene costruita quando
       * non c'e' nessun appuntamento, e il suo script la nasconde quando gli
       * ultimi sono scaduti dopo la build. In quel caso la prima schermata
       * torna a essere l'hero, e l'intro con lei. La scelta si fa qui, a tempo
       * di esecuzione, perche' solo qui si sa com'e' fatta la pagina davvero.
       */
      const agenda = document.getElementById('agenda');
      const apreAgenda = !!agenda && !agenda.hasAttribute('hidden');

      // Gli elementi dell'agenda in ordine di lettura: titolo, sommario, nastro
      // delle locandine, pulsante verso tutta l'agenda. Ognuno e' un elenco e
      // non un selettore, cosi' le tappe di una pagina fatta diversamente da
      // quella attesa si saltano invece di far fallire la timeline.
      const bersagliAgenda = apreAgenda
        ? [
            elementi('#agenda .section-title'),
            elementi('#agenda .section-sub'),
            elementi('#agenda .agenda-carosello'),
            elementi('#agenda .agenda-home-azioni'),
          ]
        : [];

      const h1 = apreAgenda ? null : document.querySelector('.hero-content h1');
      // Ogni parola del titolo finisce in uno span, per farle entrare in cascata.
      // La regola CSS della parola chiave usa :not(.cogu-w) proprio per questo:
      // senza, colorerebbe di rosa l'intero H1.
      //
      // Si fa solo quando l'intro riguarda l'hero: spezzare il titolo e metterlo
      // a opacita' zero per poi non animarlo significherebbe lasciare invisibile
      // un titolo che sta in mezzo alla pagina.
      const words: HTMLElement[] = [];
      if (h1) {
        const frag = document.createDocumentFragment();
        Array.from(h1.childNodes).forEach((node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            (node.textContent ?? '').split(/(\s+)/).forEach((tok) => {
              if (tok === '') return;
              if (/^\s+$/.test(tok)) { frag.appendChild(document.createTextNode(tok)); return; }
              const w = document.createElement('span');
              w.className = 'cogu-w';
              w.style.display = 'inline-block';
              w.textContent = tok;
              frag.appendChild(w);
              words.push(w);
            });
          } else if (node instanceof HTMLElement) {
            node.style.display = 'inline-block';
            frag.appendChild(node);
            words.push(node);
          } else {
            frag.appendChild(node);
          }
        });
        h1.innerHTML = '';
        h1.appendChild(frag);
        utils.set(h1, { opacity: 1 });
        utils.set(words, { opacity: 0 });
      }

      // Stato di partenza dell'agenda: lo mette lo script e non il solo gate
      // CSS, perche' il gate viene rimosso tutto insieme alla fine e la
      // timeline deve poter partire da zero anche nei frame in cui la classe
      // non c'e' piu'.
      bersagliAgenda.forEach((gruppo) => {
        if (gruppo.length) utils.set(gruppo, { opacity: 0 });
      });

      if (apreAgenda) {
        // L'hero non viene animato: il gate CSS lo spegne insieme all'agenda
        // (vedi il commento sulla regola html.cogu-intro) e lo riaccenderebbe
        // solo alla fine dell'intro, quattro secondi dopo. Chi scorre subito
        // troverebbe un blocco di testo invisibile in mezzo alla pagina.
        // L'opacita' inline batte il gate e lo riaccende adesso.
        utils.set(
          '.hero-badge, .hero-content h1, .hero-lead, .hero-desc, .hero-content > .btn-primary',
          { opacity: 1 }
        );
      }

      const cleanup = () => {
        if (window.__coguFailsafe) clearTimeout(window.__coguFailsafe);
        if (window.__coguReveal) window.__coguReveal();
        overlay.remove();
      };

      const tl = createTimeline({
        defaults: { ease: 'outExpo', duration: 720 },
        onComplete: cleanup,
      });

      // Il gate CSS html.cogu-intro spegne la prima schermata, ma i suoi
      // elementi hanno anche un opacity inline messo qui sopra: se la timeline
      // si blocca (scheda in background, rAF sospesi, modulo lento) togliere la
      // classe non basta e il contenuto resta invisibile. Il failsafe in
      // BaseLayout chiama questa funzione.
      //
      // Riaccende tutte e due le prime schermate possibili, non solo quella
      // scelta: il gate CSS le spegne entrambe, quindi entrambe vanno riaccese.
      window.__coguHeroReset = () => {
        try { tl.pause(); } catch (e) {}
        try {
          utils.set(words.length ? words : '.hero-content h1', { opacity: 1, translateY: 0 });
          utils.set('.hero-badge, .hero-lead, .hero-desc, .hero-content > .btn-primary',
                    { opacity: 1, translateY: 0, scale: 1 });
        } catch (e) {}
        bersagliAgenda.forEach((gruppo) => {
          if (!gruppo.length) return;
          try { utils.set(gruppo, { opacity: 1, translateY: 0 }); } catch (e) {}
        });
      };

      tl
        .add('.cogu-intro-brand', { opacity: [0, 1], translateY: [30, 0], duration: 780 })
        .add('.cogu-intro-tag',   { opacity: [0, 1], translateY: [14, 0] }, '-=500')
        .add('.cogu-intro-rule',  { scaleX: [0, 1], duration: 640 }, '-=430')
        .add('.cogu-intro-overlay', { translateY: ['0%', '-105%'], duration: 900, ease: 'inOutQuart' }, '+=260');

      if (apreAgenda) {
        // Cascata dell'agenda: titolo, sommario, poi le locandine — che sono la
        // ragione per cui questa sezione sta in cima, e quindi entrano con il
        // passo piu' lungo — e infine il pulsante.
        const [titolo, sommario, carosello, azioni] = bersagliAgenda;
        if (titolo.length)    tl.add(titolo,    { opacity: [0, 1], translateY: [26, 0], duration: 760 }, '-=560');
        if (sommario.length)  tl.add(sommario,  { opacity: [0, 1], translateY: [16, 0] }, '-=520');
        if (carosello.length) tl.add(carosello, { opacity: [0, 1], translateY: [28, 0], duration: 820 }, '-=540');
        if (azioni.length)    tl.add(azioni,    { opacity: [0, 1], translateY: [10, 0] }, '-=620');
      } else {
        tl
          .add('.hero-badge', { opacity: [0, 1], scale: [0.82, 1], translateY: [12, 0] }, '-=560')
          .add(words.length ? words : '.hero-content h1',
               { opacity: [0, 1], translateY: [32, 0], duration: 760, delay: stagger(42) }, '-=470')
          .add('.hero-lead',  { opacity: [0, 1], translateY: [16, 0] }, '-=520')
          .add('.hero-desc',  { opacity: [0, 1], translateY: [16, 0] }, '-=560')
          .add('.hero-content > .btn-primary',
               { opacity: [0, 1], scale: [0.9, 1], translateY: [10, 0], ease: 'outBack' }, '-=520');
      }

      // Il failsafe di BaseLayout scatta a 3s, ma la timeline completa dura di
      // piu': se anime.js e' partito davvero lo riprogrammiamo oltre la durata
      // reale, altrimenti taglierebbe l'ingresso a meta' a ogni caricamento.
      // Resta comunque una rete per le timeline che si bloccano.
      if (window.__coguFailsafe) clearTimeout(window.__coguFailsafe);
      window.__coguFailsafe = setTimeout(
        () => window.__coguReveal?.(),
        Math.max(tl.duration || 0, 3700) + 1500
      );
    } catch (e) {
      // anime.js non disponibile, o qualcosa e' andato storto nel costruire la
      // timeline: la pagina deve restare leggibile comunque.
      if (window.__coguReveal) window.__coguReveal();
    }
  }

  // Con "movimento ridotto" attivo non si parte proprio: nessun pannello, nessuna
  // animazione, la prima schermata e' visibile fin dal primo istante (lo script
  // inline in BaseLayout non ha nemmeno applicato il gate CSS).
  const movimentoRidotto =
    window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!movimentoRidotto) avviaIntro();
</script>
