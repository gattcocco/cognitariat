---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banners from '../components/Banners.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CosaSucceded from '../components/CosaSucceded.astro';
import PercheCiPreoccupa from '../components/PercheCiPreoccupa.astro';
import Lavoro from '../components/Lavoro.astro';
import Alternative from '../components/Alternative.astro';
import AssemblyBanner from '../components/AssemblyBanner.astro';
import CosaFacciamo from '../components/CosaFacciamo.astro';
import VideoInterviews from '../components/VideoInterviews.astro';
import CosaCostruiamo from '../components/CosaCostruiamo.astro';
import Avvicinarsi from '../components/Avvicinarsi.astro';
import Imaginarium from '../components/Imaginarium.astro';
import Membership from '../components/Membership.astro';
import Merch from '../components/Merch.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <Banners />
  <Header />
  <main id="contenuto" tabindex="-1">
    <!--
      Ordine editoriale di docs/copy-home-v2.md: prima cosa succede e perche'
      ci preoccupa, poi il lavoro, poi le alternative (che occupano almeno tanto
      spazio quanto le preoccupazioni), poi cosa facciamo davvero, poi cosa e'
      solo un progetto, infine come avvicinarsi.
    -->
    <Hero />
    <CosaSucceded />
    <PercheCiPreoccupa />
    <Lavoro />
    <Alternative />
    <AssemblyBanner />
    <CosaFacciamo />
    <VideoInterviews />
    <CosaCostruiamo />
    <Avvicinarsi />
    <Imaginarium />
    <!--
      Tesseramento e merch restano nella pagina con le strutture intatte, ma con
      gli acquisti disabilitati: nessun pulsante deve far pensare che si possa
      gia' pagare. Vedi Fase 5 per il gating lato server.
    -->
    <Membership />
    <Merch />
    <Footer />
  </main>
</BaseLayout>

<script is:inline type="module">
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    try {
      const { createTimeline, stagger, utils } =
        await import('https://cdn.jsdelivr.net/npm/animejs/+esm');

      const overlay = document.createElement('div');
      overlay.className = 'cogu-intro-overlay';
      overlay.setAttribute('aria-hidden', 'true');
      overlay.innerHTML =
        '<div class="cogu-intro-mark">' +
        '<span class="cogu-intro-brand">COG U</span>' +
        '<span class="cogu-intro-tag">Sindacato e osservatorio</span>' +
        '<span class="cogu-intro-rule"></span>' +
        '</div>';
      document.body.appendChild(overlay);

      const h1 = document.querySelector('.hero-content h1');
      const words = [];
      if (h1) {
        const frag = document.createDocumentFragment();
        Array.from(h1.childNodes).forEach((node) => {
          if (node.nodeType === 3) {
            node.textContent.split(/(\s+)/).forEach((tok) => {
              if (tok === '') return;
              if (/^\s+$/.test(tok)) { frag.appendChild(document.createTextNode(tok)); return; }
              const w = document.createElement('span');
              w.className = 'cogu-w';
              w.style.display = 'inline-block';
              w.textContent = tok;
              frag.appendChild(w);
              words.push(w);
            });
          } else if (node.nodeType === 1) {
            node.style.display = 'inline-block';
            frag.appendChild(node);
            words.push(node);
          } else {
            frag.appendChild(node);
          }
        });
        h1.innerHTML = '';
        h1.appendChild(frag);
        utils.set(h1, { opacity: 1 });
        utils.set(words, { opacity: 0 });
      }

      const cleanup = () => {
        if (window.__coguFailsafe) clearTimeout(window.__coguFailsafe);
        if (window.__coguReveal) window.__coguReveal();
        overlay.remove();
      };

      const tl = createTimeline({
        defaults: { ease: 'outExpo', duration: 720 },
        onComplete: cleanup,
      });

      // Il gate CSS html.cogu-intro spegne l'hero, ma le parole del titolo hanno
      // anche un opacity inline messo qui sopra: se la timeline si blocca (scheda
      // in background, rAF sospesi, CDN lenta) togliere la classe non basta e il
      // titolo resta invisibile. Il failsafe in BaseLayout chiama questa funzione.
      window.__coguHeroReset = () => {
        try { tl.pause(); } catch (e) {}
        try {
          utils.set(words.length ? words : '.hero-content h1', { opacity: 1, translateY: 0 });
          utils.set('.hero-badge, .hero-lead, .hero-desc, .hero-content > .btn-primary',
                    { opacity: 1, translateY: 0, scale: 1 });
        } catch (e) {}
      };

      tl
        .add('.cogu-intro-brand', { opacity: [0, 1], translateY: [30, 0], duration: 780 })
        .add('.cogu-intro-tag',   { opacity: [0, 1], translateY: [14, 0] }, '-=500')
        .add('.cogu-intro-rule',  { scaleX: [0, 1], duration: 640 }, '-=430')
        .add('.cogu-intro-overlay', { translateY: ['0%', '-105%'], duration: 900, ease: 'inOutQuart' }, '+=260')
        .add('.hero-badge', { opacity: [0, 1], scale: [0.82, 1], translateY: [12, 0] }, '-=560')
        .add(words.length ? words : '.hero-content h1',
             { opacity: [0, 1], translateY: [32, 0], duration: 760, delay: stagger(42) }, '-=470')
        .add('.hero-lead',  { opacity: [0, 1], translateY: [16, 0] }, '-=520')
        .add('.hero-desc',  { opacity: [0, 1], translateY: [16, 0] }, '-=560')
        .add('.hero-content > .btn-primary',
             { opacity: [0, 1], scale: [0.9, 1], translateY: [10, 0], ease: 'outBack' }, '-=520');

      // Il failsafe di BaseLayout scatta a 3s, ma la timeline completa dura di
      // piu': se anime.js e' partito davvero lo riprogrammiamo oltre la durata
      // reale, altrimenti taglierebbe l'ingresso a meta' a ogni caricamento.
      // Resta comunque una rete per le timeline che si bloccano.
      if (window.__coguFailsafe) clearTimeout(window.__coguFailsafe);
      window.__coguFailsafe = setTimeout(window.__coguReveal,
                                        Math.max(tl.duration || 0, 3700) + 1500);
    } catch (e) {
      if (window.__coguReveal) window.__coguReveal();
    }
  }
</script>
